# Leave OFF until the IRB protocol is approved AND the research office has
# confirmed where the data may be stored. While off, nothing leaves the browser.
VITE_RECORDING=off

# Only used when VITE_RECORDING=on. Set these in Vercel, never in the repo.
# SCSU's Qualtrics instance is stcloudstate.co1.qualtrics.com, so the datacenter is co1.
QUALTRICS_DATACENTER=co1
QUALTRICS_API_TOKEN=
QUALTRICS_SURVEY_ID=
QUALTRICS_CONTACT_SURVEY_ID=
